# Copy to .env (never commit it). Every variable is optional; the defaults
# suit `make run` with `make services` (PostgreSQL and Redis from the game's
# compose file, BalatroFrontEnd/docker-compose.yml).

# The service's public base URL: the access tokens' issuer (iss). BalatroWebAPI
# must expect the same value (BALATRO_API_AUTH_ISSUER).
PUBLIC_URL=http://localhost:8001
# Browser origins allowed to call the service, comma separated
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:8087

DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:55432/identity
REDIS_URL=redis://localhost:56379/0

# The RS256 signing key: a PEM in JWT_PRIVATE_KEY, or a file (made on the
# first start when missing, unless JWT_GENERATE_KEY=false)
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_GENERATE_KEY=true
JWT_AUDIENCE=balatro
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# notifications: hand the codes to the notification service (BalatroNotificationService)
# through RabbitMQ, which writes and sends the emails (what `make dev` and the
# Docker stack use); or send plain emails from here: console (the log) or smtp
# (with `make services-mail`: EMAIL_BACKEND=smtp SMTP_HOST=localhost SMTP_PORT=1025
# SMTP_SECURITY=none, then read the emails at http://localhost:8025)
EMAIL_BACKEND=console
EMAIL_FROM=Balatro <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) or none
SMTP_SECURITY=starttls
# with EMAIL_BACKEND=notifications (the compose file's rabbitmq)
RABBITMQ_URL=amqp://balatro:balatro@localhost:5672/

# Google sign-in is on when both are set (console.cloud.google.com,
# "OAuth client ID", type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where providers may send the browser back: the portal's /auth/callback page,
# comma separated. Register each one as an "Authorized redirect URI" at Google.
OAUTH_REDIRECT_URIS=http://localhost:5174/auth/callback,http://localhost:8087/auth/callback
